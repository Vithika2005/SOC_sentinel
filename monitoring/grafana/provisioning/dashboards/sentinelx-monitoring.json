{
  "uid": "sentinelx-monitoring",
  "title": "SentinelX Infrastructure Monitoring",
  "tags": [
    "sentinelx",
    "security",
    "infrastructure"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",

  "templating": {
    "list": []
  },

  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Healthy HTTP Services",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelx-prometheus"
      },
      "targets": [
        {
          "expr": "sum(probe_success{job=\"sentinelx-http-health\"})",
          "legendFormat": "Healthy",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null
              },
              {
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value"
      }
    },


    {
      "id": 2,
      "type": "stat",
      "title": "HTTP Services Monitored",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelx-prometheus"
      },
      "targets": [
        {
          "expr": "count(probe_success{job=\"sentinelx-http-health\"})",
          "legendFormat": "Services",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },


    {
      "id": 3,
      "type": "stat",
      "title": "HTTP Services Down",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelx-prometheus"
      },
      "targets": [
        {
          "expr": "count(probe_success{job=\"sentinelx-http-health\"} == 0)",
          "legendFormat": "Down",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },


    {
      "id": 4,
      "type": "table",
      "title": "SentinelX HTTP Service Health",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelx-prometheus"
      },
      "targets": [
        {
          "expr": "probe_success{job=\"sentinelx-http-health\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "__name__": true
            },
            "renameByName": {
              "instance": "Service Endpoint",
              "Value": "Status"
            }
          }
        }
      ]
    },


    {
      "id": 5,
      "type": "timeseries",
      "title": "Service Response Time",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelx-prometheus"
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=\"sentinelx-http-health\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },


    {
      "id": 6,
      "type": "table",
      "title": "Infrastructure TCP Health",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelx-prometheus"
      },
      "targets": [
        {
          "expr": "probe_success{job=~\"postgres-health|kafka-health\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "__name__": true
            },
            "renameByName": {
              "instance": "Endpoint",
              "Value": "Status"
            }
          }
        }
      ]
    },


    {
      "id": 7,
      "type": "stat",
      "title": "Qdrant",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelx-prometheus"
      },
      "targets": [
        {
          "expr": "probe_success{job=\"qdrant-health\"}",
          "legendFormat": "Qdrant",
          "refId": "A"
        }
      ]
    },


    {
      "id": 8,
      "type": "stat",
      "title": "Neo4j",
      "gridPos": {
        "x": 18,
        "y": 12,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelx-prometheus"
      },
      "targets": [
        {
          "expr": "probe_success{job=\"neo4j-health\"}",
          "legendFormat": "Neo4j",
          "refId": "A"
        }
      ]
    },


    {
      "id": 9,
      "type": "stat",
      "title": "Kafka",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelx-prometheus"
      },
      "targets": [
        {
          "expr": "probe_success{job=\"kafka-health\"}",
          "legendFormat": "Kafka",
          "refId": "A"
        }
      ]
    },


    {
      "id": 10,
      "type": "stat",
      "title": "PostgreSQL",
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelx-prometheus"
      },
      "targets": [
        {
          "expr": "probe_success{job=\"postgres-health\"}",
          "legendFormat": "PostgreSQL",
          "refId": "A"
        }
      ]
    }

  ]
}